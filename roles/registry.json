{
  "$comment": "The org clock. Every unattended role job in konyklabs is here or does not exist. Cadence, budget and blast radius live in this file rather than in a prompt, so a role cannot widen its own remit without a reviewed diff. Crons are UTC and deliberately off :00 and :30. `scope` binds a job to the issue that triggered it: an event-scoped job may only act on that issue, because its primary input is text a stranger wrote.",
  "footer": "konyklabs-role",
  "clock": {
    "$comment": "Crons the caller is allowed to declare that are not registry jobs. Without this list the caller-to-registry direction of the drift check would flag the heartbeat's own cron every week.",
    "reserved": [
      {
        "cron": "41 16 * * 5",
        "what": "role-heartbeat itself, which is a separate reusable workflow rather than a role job"
      }
    ]
  },
  "labels": {
    "$comment": "The only labels a role job may add or remove. Anything else is an escalation, not a label.",
    "allowed": [
      "idea",
      "spike",
      "decision",
      "build",
      "icebox",
      "ready",
      "blocked",
      "stale",
      "needs-detail",
      "bug",
      "documentation",
      "enhancement",
      "question"
    ]
  },
  "jobs": [
    {
      "id": "po-intake",
      "role": "product-owner",
      "brief": "intake",
      "repo": "konyklabs/roadmap",
      "trigger": "issues.opened",
      "window": null,
      "model": "sonnet",
      "effort": "high",
      "max_turns": 40,
      "caps": {
        "comment": 1,
        "label": 4,
        "unlabel": 2,
        "create-issue": 0,
        "close-issue": 0,
        "set-field": 4,
        "escalate": 1
      },
      "scope": "triggering-issue"
    },
    {
      "id": "po-backlog-review",
      "role": "product-owner",
      "brief": "backlog-review",
      "repo": "konyklabs/roadmap",
      "trigger": "cron",
      "cron": "17 13 * * 1",
      "window": "8d",
      "model": "opus",
      "effort": "high",
      "max_turns": 150,
      "caps": {
        "comment": 8,
        "label": 20,
        "unlabel": 20,
        "create-issue": 0,
        "close-issue": 0,
        "set-field": 40,
        "escalate": 2
      },
      "scope": "repo"
    },
    {
      "id": "dm-flow-sweep",
      "role": "delivery-manager",
      "brief": "flow-sweep",
      "repo": "konyklabs/roadmap",
      "trigger": "cron",
      "cron": "23 6 * * *",
      "window": "36h",
      "model": "sonnet",
      "effort": "high",
      "max_turns": 90,
      "caps": {
        "comment": 4,
        "label": 12,
        "unlabel": 12,
        "create-issue": 0,
        "close-issue": 0,
        "set-field": 30,
        "escalate": 2
      },
      "scope": "repo"
    },
    {
      "id": "dm-weekly-report",
      "role": "delivery-manager",
      "brief": "weekly-report",
      "repo": "konyklabs/roadmap",
      "trigger": "cron",
      "cron": "11 15 * * 5",
      "window": "8d",
      "model": "opus",
      "effort": "high",
      "max_turns": 120,
      "caps": {
        "comment": 1,
        "label": 0,
        "unlabel": 0,
        "create-issue": 0,
        "close-issue": 0,
        "set-field": 0,
        "escalate": 1
      },
      "scope": "repo"
    },
    {
      "id": "arch-drift-audit",
      "role": "architect",
      "brief": "drift-audit",
      "repo": "konyklabs/roadmap",
      "trigger": "cron",
      "cron": "7 14 * * 3",
      "window": "8d",
      "model": "opus",
      "effort": "xhigh",
      "max_turns": 200,
      "caps": {
        "comment": 3,
        "label": 6,
        "unlabel": 2,
        "create-issue": 3,
        "close-issue": 0,
        "set-field": 10,
        "escalate": 2
      },
      "scope": "repo"
    }
  ]
}
